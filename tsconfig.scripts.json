{
  // Typechecks repo-level tooling (build scripts, the Vitest workspace file).
  // Composite so `tsc --build` can treat it as a project reference; emitted
  // declarations land in dist/ and are never consumed.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/tooling",
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts", "vitest.config.ts"]
}
