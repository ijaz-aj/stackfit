// Persistence for saved scoping sessions (PROJECT_SPEC §2).
//
// Postgres, on one provider for every environment. It was SQLite, chosen for
// zero setup and written Postgres-portable from the start, and the move cost
// exactly the two lines below because that promise held: no SQLite-only
// features and every column type exists on both.
//
// Why not keep SQLite for local work and Postgres for the deployment. A
// serverless host gives each invocation a fresh filesystem, so a SQLite file
// there is not slow or awkward, it is gone: writes vanish between requests.
// That forces Postgres for the deployment, and once the deployment is Postgres,
// developing against a different engine means the database you test on is not
// the one you ship on. Local now needs a `DATABASE_URL` too, which is a real
// cost in setup and a smaller one than that drift.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// One saved scoping session: the client profile plus the inventory it was
/// sized from. Everything else, sizing, costs, bundles, coverage, is derived
/// by the engine on read, never stored, because a stored recommendation would
/// go stale the moment a price or a coefficient changed.
model Scenario {
  id   String @id @default(cuid())
  name String

  /// ClientProfile as JSON text, Zod-parsed on the way in and on the way out.
  ///
  /// Text rather than a Json column. It began as a portability constraint,
  /// Prisma having no Json scalar on SQLite, and it stays on Postgres by
  /// choice: the validation that matters happens in Zod, the database never
  /// queries inside this blob, and `StoredClientProfile` migrates old shapes on
  /// read. A jsonb column would buy database-side syntax checking of something
  /// no query looks into.
  profile String

  /// AssetInventory as JSON text, same reasoning.
  inventory String

  /// This client's corrections to the sizing coefficients (§8.6), as JSON text.
  ///
  /// Written only by the results worksheet, never by the intake wizard: two
  /// tabs open on one scenario must not have the wizard's autosave quietly
  /// undo an override the analyst just typed on the dashboard.
  overrides String @default("{}")

  /// Auth seam (docs/STATUS.md, Q3). No auth in v1; these stay null until
  /// there is, and exist so that adding it is a migration nobody has to think
  /// hard about.
  ownerId   String?
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
