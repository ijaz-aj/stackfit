# Optional locally. Without any of it the app runs in single-user local mode:
# `pnpm dev` works with no .env file at all, which is deliberate.
#
# All of it is REQUIRED in production. A hosted instance with authentication
# unconfigured refuses to serve a request rather than exposing every saved
# scoping session, including client asset inventories, to anyone with the URL.

# Signs the session cookie. Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET=""

# The canonical URL of the deployment, e.g. https://stackfit.example.com
# Vercel sets this for you; set it by hand anywhere else.
# NEXTAUTH_URL=""

# At least one provider. Callback URL to register with the provider is
# <NEXTAUTH_URL>/api/auth/callback/google (or /github).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Who may sign in, comma-separated. OAuth proves identity; this grants access.
# An empty or missing list admits NOBODY, a configuration failure reads as
# "no", never as "everyone".
# STACKFIT_ALLOWED_EMAILS="analyst@example.com,lead@example.com"

# Optional. Without it the app and the Prisma CLI both fall back to a local
# SQLite file (apps/web/stackfit.db), which is the zero-setup path.
#
# Point it at Postgres when this is hosted; the schema is written to be portable
# and the only change needed is the datasource provider.
# DATABASE_URL="file:./stackfit.db"
