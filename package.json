{
  "name": "stackfit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Security Solution Advisor & Budget Portal — stack recommendation and TCO engine",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @stackfit/web dev",
    "build": "tsc --build && pnpm --filter @stackfit/web build",
    "test": "vitest run",
    "test:engine": "vitest run --project engine",
    "typecheck": "tsc --build --force && pnpm --filter @stackfit/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "catalog:staleness": "tsx scripts/catalog-staleness.ts",
    "prices:refresh": "tsx scripts/refresh-prices.ts",
    "db:push": "pnpm --filter @stackfit/web db:push",
    "db:generate": "pnpm --filter @stackfit/web db:generate",
    "seed": "pnpm --filter @stackfit/web seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stackfit/data": "workspace:*",
    "@stackfit/engine": "workspace:*",
    "@stackfit/schema": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yaml": "^2.6.1"
  },
  "pnpm": {
    "overrides": {
      "mysql2": "^3.23.1",
      "deepmerge-ts": "^8.0.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/engines",
      "better-sqlite3"
    ]
  }
}
